# Общее
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (локально уже есть — создай две БД: hcf_core, hcf_farm)
CORE_DB_NAME=hcf_core
CORE_DB_USER=postgres
CORE_DB_PASSWORD=postgres
CORE_DB_HOST=localhost
CORE_DB_PORT=5432

FARM_DB_NAME=hcf_farm
FARM_DB_USER=postgres
FARM_DB_PASSWORD=postgres
FARM_DB_HOST=localhost
FARM_DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Core <-> Farm API
CORE_API_URL=http://localhost:8000
FARM_API_URL=http://localhost:8001
INTERNAL_API_TOKEN=change-me-in-production